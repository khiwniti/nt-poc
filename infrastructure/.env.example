# Environment Configuration for SSL/TLS Setup
# Copy this file to .env and update with your actual values

# Domain Configuration
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=battery_management
DB_USER=battery_user
DB_PASSWORD=your_secure_password_here

# Application Secrets
JWT_SECRET=your_jwt_secret_minimum_32_characters_long

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=alerts@yourdomain.com
EMAIL_FROM_NAME=Battery Management System

# SSL/TLS Configuration
SSL_MODE=letsencrypt  # Options: letsencrypt, custom, selfsigned
CERT_EMAIL=admin@yourdomain.com

# Monitoring
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
