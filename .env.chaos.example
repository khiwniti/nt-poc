# Chaos Testing Configuration Example
# Copy to .env or .env.test and customize as needed

# ==============================================
# Chaos Testing Configuration
# ==============================================

# Enable/Disable chaos testing (default: false)
# WARNING: Keep false in production!
CHAOS_ENABLED=false

# Failure rate: probability of failure (0.0 to 1.0)
# 0.0 = never fail, 1.0 = always fail
# Recommended: 0.1-0.3 for realistic testing
CHAOS_FAILURE_RATE=0.1

# Enable/disable specific failure scenarios
# Set to 'false' to disable a specific scenario
CHAOS_SERVICE_FAILURE=true
CHAOS_NETWORK_LATENCY=true
CHAOS_DATABASE_FAILURE=true
CHAOS_REDIS_FAILURE=true

# Network latency configuration (in milliseconds)
# Random delay will be chosen between min and max
CHAOS_LATENCY_MIN=100
CHAOS_LATENCY_MAX=3000

# ==============================================
# Example Configurations by Environment
# ==============================================

# Development (light testing)
# CHAOS_ENABLED=true
# CHAOS_FAILURE_RATE=0.05
# CHAOS_LATENCY_MIN=50
# CHAOS_LATENCY_MAX=500

# Staging (moderate testing)
# CHAOS_ENABLED=true
# CHAOS_FAILURE_RATE=0.2
# CHAOS_LATENCY_MIN=100
# CHAOS_LATENCY_MAX=1000

# Load Testing (high stress)
# CHAOS_ENABLED=true
# CHAOS_FAILURE_RATE=0.5
# CHAOS_LATENCY_MIN=500
# CHAOS_LATENCY_MAX=3000

# Production (NEVER ENABLE)
# CHAOS_ENABLED=false

# ==============================================
# Usage Examples
# ==============================================

# 1. Enable chaos testing with API:
#    curl -X POST http://localhost:3000/api/v1/chaos/enable

# 2. Configure failure rate:
#    curl -X POST http://localhost:3000/api/v1/chaos/config \
#      -H "Content-Type: application/json" \
#      -d '{"failureRate": 0.3}'

# 3. Test specific scenario:
#    curl -X POST http://localhost:3000/api/v1/chaos/test/service-failure

# 4. Disable chaos testing:
#    curl -X POST http://localhost:3000/api/v1/chaos/disable

# 5. Run automated test suite:
#    ./chaos-testing.sh
