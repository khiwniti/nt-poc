{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/frontend/Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'cd services/frontend && serve -s dist -l $PORT'",
    "restartPolicy": "on_failure",
    "restartPolicyMaxRetries": 10
  }
}
