# Percy Environment Variables

# Percy.io API token (required for visual regression testing)
# Get from: https://percy.io/settings
PERCY_TOKEN=

# Optional: Percy project name
PERCY_PROJECT=nt-poc-frontend

# Optional: Percy organization
PERCY_ORG=

# Optional: Percy branch (auto-detected from git)
# PERCY_BRANCH=

# Optional: Percy parallel total (for parallel CI builds)
# PERCY_PARALLEL_TOTAL=

# Optional: Percy parallel nonce (for parallel CI builds)
# PERCY_PARALLEL_NONCE=
