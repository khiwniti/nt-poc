# ===========================================
# FRONTEND - DEVELOPMENT ENVIRONMENT
# ===========================================
# ⚠️  Variables prefixed with VITE_ are exposed to the browser
# ===========================================

# API Endpoints
VITE_API_BASE_URL=http://localhost:3000
VITE_MLOPS_SERVICE_URL=http://localhost:8001

# External API Keys (optional)
# VITE_MAPBOX_API_KEY=your-mapbox-api-key
# VITE_OPENWEATHER_API_KEY=your-openweather-api-key

# Application Settings
VITE_APP_NAME=Battery Management System
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_DEBUG_MODE=true

# Error Tracking (optional)
# VITE_SENTRY_DSN=your-sentry-frontend-dsn
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_RELEASE=local-dev

# UI Settings
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true

# Build Settings
NODE_ENV=development
GENERATE_SOURCEMAP=true
