# LINE Bot Configuration
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# AI Configuration - Choose ONE of the following options:

# Option 1: GitHub Models (Azure OpenAI Compatible) - Recommended
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_MODEL_ENDPOINT=https://models.inference.ai.azure.com
AI_MODEL=gpt-4o
# Alternative models: gpt-4o-mini, gpt-4, gpt-3.5-turbo

# Option 2: OpenAI Direct
# OPENAI_API_KEY=your_openai_api_key_here
# AI_MODEL=gpt-4o
# AI_BASE_URL=https://api.openai.com/v1

# Option 3: Custom OpenAI Compatible Endpoint
# OPENAI_API_KEY=your_api_key
# AI_BASE_URL=your_custom_endpoint
# AI_MODEL=your_model_name

# Backend API URL
BACKEND_API_URL=http://localhost:3000

# Server Configuration
PORT=3002
NODE_ENV=development

# Logging
LOG_LEVEL=info
