# Battery Simulator Service Configuration

# Application Settings
APP_NAME=Battery Simulator Service
ENVIRONMENT=development
PORT=8001
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============================================================================
# CRITICAL: Sensor Backend Selection
# ============================================================================
# Options: "simulator" or "hardware"
# Change this value to switch between simulated and real hardware sensors.
# NO CODE CHANGES REQUIRED - just change this value and restart the service.
# ============================================================================
SENSOR_BACKEND=simulator

# ============================================================================
# Simulator Configuration (used when SENSOR_BACKEND=simulator)
# ============================================================================

# Random seed for deterministic simulation (leave empty for random behavior)
# Set to a number (e.g., 42) for reproducible testing
SIMULATOR_SEED=

# Noise level for sensor readings (0.0 = no noise, 1.0 = high noise)
SIMULATOR_NOISE_LEVEL=0.02

# Enable temporal drift (SoC decreases, SoH degrades over time)
SIMULATOR_DRIFT_ENABLED=true

# Minimum interval between state updates (milliseconds)
SIMULATOR_UPDATE_INTERVAL_MS=1000

# State of Charge decay rate per minute under typical load
SIMULATOR_SOC_DECAY_RATE=0.1

# State of Health decay rate per charge cycle
SIMULATOR_SOH_DECAY_RATE=0.0001

# LRU cache size for battery state management (production scale)
# Recommended: 500 for 1,944 batteries (caches 25% most-accessed)
# Increase if your fleet has higher cache hit rate requirements
SIMULATOR_CACHE_SIZE=500

# ============================================================================
# Batch Processing Configuration (production scale optimization)
# ============================================================================

# Maximum batteries per batch request
# For 1,944 batteries: 200 allows ~10 batches to cover fleet
BATCH_MAX_SIZE=200

# Number of concurrent workers for parallel batch processing
# Higher = faster batch processing but more CPU/memory usage
BATCH_PARALLEL_WORKERS=10

# ============================================================================
# Hardware Configuration (used when SENSOR_BACKEND=hardware)
# ============================================================================
# Uncomment and configure these settings when using real hardware sensors

# Connection string for hardware sensors
# Examples:
#   - Serial: /dev/ttyUSB0:9600
#   - TCP: tcp://192.168.1.100:5000
#   - Modbus: modbus://192.168.1.100:502
# HARDWARE_CONNECTION_STRING=tcp://192.168.1.100:5000

# Timeout for hardware communication (milliseconds)
# HARDWARE_TIMEOUT_MS=3000

# Number of retry attempts for failed hardware reads
# HARDWARE_RETRY_ATTEMPTS=3

# Delay between retry attempts (milliseconds)
# HARDWARE_RETRY_DELAY_MS=500

# ============================================================================
# Production Scale Performance Tuning
# ============================================================================
#
# For 1,944 batteries across 9 data centers:
#
# Recommended Settings:
# - SIMULATOR_CACHE_SIZE=500 (25% of fleet, covers most-accessed batteries)
# - BATCH_MAX_SIZE=200 (allows 10 batches to cover entire fleet)
# - BATCH_PARALLEL_WORKERS=10 (balance between speed and resource usage)
#
# Expected Performance:
# - Single battery reading: < 5ms
# - Batch of 200 batteries: < 2 seconds (with parallel processing)
# - Full fleet (1,944 batteries): ~20 seconds (10 batches × 2s)
#
# Cache Hit Rate:
# - After warm-up: 70-80% (frequently accessed batteries stay cached)
# - LRU eviction ensures memory stays bounded at ~500 battery states
#
# Memory Usage:
# - Per battery state: ~500 bytes
# - 500 cached states: ~250 KB
# - Total simulator overhead: < 5 MB
#
# ============================================================================
# Switching Between Simulator and Hardware
# ============================================================================
#
# To switch from simulator to hardware:
# 1. Change: SENSOR_BACKEND=hardware
# 2. Set: HARDWARE_CONNECTION_STRING=<your hardware connection>
# 3. Restart the service
#
# To switch back to simulator:
# 1. Change: SENSOR_BACKEND=simulator
# 2. Restart the service
#
# NO CODE CHANGES REQUIRED!
# ============================================================================
