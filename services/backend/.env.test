# Test Environment Configuration
NODE_ENV=test

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=battery_management_test
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/battery_management_test

# JWT Secret
JWT_SECRET=test-secret

# Redis - Disabled in tests
REDIS_DISABLED=true

# Email - Disabled in tests (no SendGrid key)
# SENDGRID_API_KEY=

# External APIs - Use test keys
OPENWEATHER_API_KEY=test_key
GOOGLE_MAPS_API_KEY=test_key

# Logging
LOG_LEVEL=error

# Feature Flags
ENABLE_MONITORING=false

# Port
PORT=3001
