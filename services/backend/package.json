{
  "name": "@nt-poc/backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "test": "vitest",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:migrations": "vitest run migration-tests/databaseMigrations.test.ts",
    "test:coverage": "vitest --coverage",
    "test:seed": "tsx src/test/seeds/seedTestData.ts",
    "test:seed:minimal": "tsx -e \"import('./src/test/seeds/seedTestData.ts').then(m => m.seedMinimalTestData())\"",
    "test:cleanup": "tsx src/test/utils/cleanup.ts",
    "test:reset": "tsx src/test/utils/cleanup.ts reset",
    "migrate:manual": "tsx scripts/migrate.ts",
    "migrate:rollback": "tsx scripts/migrate-rollback.ts",
    "migrate:status": "tsx scripts/migrate-status.ts",
    "migrate:make": "tsx --tsconfig tsconfig.json ../../node_modules/knex/bin/cli.js migrate:make --knexfile knexfile.ts",
    "seed:run": "tsx scripts/seed.ts",
    "seed:production": "tsx seeds/002_production_fleet.ts",
    "db:setup": "npm run migrate:manual && npm run seed:run",
    "db:setup:production": "npm run migrate:manual && npm run seed:production",
    "verify:9-battery": "tsx scripts/verify-9-battery-config.ts",
    "verify:production-fleet": "tsx scripts/verify-production-fleet.ts",
    "postinstall": "echo 'Backend installed. Run npm run migrate manually when database is ready.'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run lint && npm run format:check",
    "test:pact": "vitest run --config vitest.pact.config.ts --reporter=verbose",
    "test:pact:verify": "vitest run --config vitest.pact.config.ts --reporter=verbose",
    "prepare": "cd ../.. && husky install services/backend/.husky"
  },
  "dependencies": {
    "@sentry/node": "^10.33.0",
    "@sentry/profiling-node": "^10.33.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "ml-random-forest": "^2.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "tsx": "^4.7.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.2.0",
    "@pact-foundation/pact": "^13.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "bcrypt": "^6.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.7",
    "prettier": "^3.7.4",
    "supertest": "^7.2.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^1.2.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
