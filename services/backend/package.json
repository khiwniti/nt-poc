{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "vitest",
    "test:migrations": "vitest run migration-tests/databaseMigrations.test.ts",
    "test:coverage": "vitest --coverage",
    "test:seed": "tsx src/test/seeds/seedTestData.ts",
    "test:seed:minimal": "tsx -e \"import('./src/test/seeds/seedTestData.ts').then(m => m.seedMinimalTestData())\"",
    "test:cleanup": "tsx src/test/utils/cleanup.ts",
    "test:reset": "tsx src/test/utils/cleanup.ts reset",
    "test:security": "bash scripts/security/run-security-tests.sh --unit-only",
    "test:security:zap": "bash scripts/security/run-security-tests.sh --zap",
    "test:security:full": "bash scripts/security/run-security-tests.sh --zap --start-zap --stop-zap",
    "security:zap:start": "bash scripts/security/zap-start.sh",
    "security:zap:stop": "bash scripts/security/zap-stop.sh",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:rollback": "tsx scripts/migrate-rollback.ts",
    "migrate:status": "tsx scripts/migrate-status.ts",
    "migrate:make": "tsx --tsconfig tsconfig.json node_modules/knex/bin/cli.js migrate:make --knexfile knexfile.ts",
    "seed:run": "tsx --tsconfig tsconfig.json node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts",
    "db:setup": "npm run migrate && npm run seed:run",
    "postinstall": "npm run migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "cd ../.. && husky install services/backend/.husky"
  },
  "dependencies": {
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "ml-cart": "^2.1.1",
    "ml-random-forest": "^2.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^1.2.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
