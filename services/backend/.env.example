DB_HOST=localhost
DB_PORT=5432
DB_NAME=battery_management
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=your-secret-key
PORT=3000

# Scheduled Job Configuration
# Interval in minutes for ML prediction job (default: 60 = 1 hour)
PREDICTION_JOB_INTERVAL_MINUTES=60

# Email Notification Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=alerts@battery-management.com
EMAIL_FROM_NAME=Battery Management System
DASHBOARD_BASE_URL=http://localhost:3001
