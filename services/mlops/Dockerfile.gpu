# MLOps Service Dockerfile - GPU variant
# Python 3.11+ with TensorFlow GPU support

FROM tensorflow/tensorflow:2.15.0-gpu

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements (excluding tensorflow since it's in base image)
COPY requirements.txt .

# Install remaining Python dependencies
RUN pip install --no-cache-dir $(cat requirements.txt | grep -v "^tensorflow")

# Copy application code
COPY src/ ./src/
COPY app/ ./app/

# Set Python path
ENV PYTHONPATH=/app

# Expose service port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Run application
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8001"]
