# ===========================================
# MLOPS SERVICE - PRODUCTION CONFIGURATION
# ===========================================
#
# This MLOps service handles RUL (Remaining Useful Life) predictions
# for 1,944 batteries across 9 data centers.
#
# Production Scale:
# - 1,944 batteries total (216 per facility × 9 facilities)
# - Batch predictions: up to 500 batteries per request
# - Prediction frequency: hourly scheduled jobs
# - Expected latency: <100ms p95 for single prediction
# - Expected throughput: ~200 batteries/second for batch

# Application
APP_NAME=MLOps Service
ENVIRONMENT=production
PORT=8001

# CORS - Production domains
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8001","https://your-production-domain.com"]

# Model Configuration
MODELS_DIR=models
MODEL_VERSION=v1.0.0
RUL_MODEL_PATH=/app/models/rul_lstm_model.h5

# ========================================
# PRODUCTION BATCH PROCESSING
# ========================================

# Maximum batteries per batch prediction request
# - For 1,944 total batteries, use 500 to process fleet in ~4 batches
# - Adjust based on memory constraints (each prediction ~2KB memory)
# - Range: 10-2000, recommended: 500 for production
BATCH_MAX_SIZE=500

# Parallel workers for batch predictions
# - 10 workers = ~10x speedup for independent predictions
# - Adjust based on CPU cores available (1-2 workers per core)
# - Range: 1-50, recommended: 10-20 for production
BATCH_PARALLEL_WORKERS=10

# ========================================
# MODEL CACHE CONFIGURATION
# ========================================

# Maximum models cached in memory
# - Cache loaded models to avoid repeated disk I/O
# - Each model ~50-200MB depending on architecture
# - Range: 1-10, recommended: 4 for production
MODEL_CACHE_SIZE=4

# ========================================
# PREDICTION OPTIMIZATION
# ========================================

# Internal TensorFlow batch size for predictions
# - Larger batches = better GPU utilization (if available)
# - Balance between memory usage and throughput
# - Range: 10-200, recommended: 50 for production
PREDICTION_BATCH_SIZE=50

# Time steps for feature window (sequence length)
# - Number of historical readings used per prediction
# - Must match model training configuration
# - Range: 5-50, typical: 10 for LSTM models
FEATURE_WINDOW_SIZE=10

# ========================================
# OPTIONAL: REDIS CACHING
# ========================================
# Enable Redis for prediction result caching
# - Cache predictions for 1 hour to reduce redundant inference
# - Significantly improves response time for repeated queries

# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=1
# REDIS_TTL_SECONDS=3600

# ========================================
# OPTIONAL: DATABASE CONNECTION
# ========================================
# Connect to TimescaleDB for feature extraction
# - Directly query sensor_readings for historical data
# - Eliminates need for backend to pass features

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=battery_management
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false

# ========================================
# LOGGING & MONITORING
# ========================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Worker processes for uvicorn
# - Multiple workers for CPU-bound workloads
# - Single worker recommended if using GPU
WORKER_PROCESSES=2

# ========================================
# ERROR TRACKING
# ========================================
# Optional Sentry integration for error monitoring

# SENTRY_DSN=your-sentry-dsn
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ========================================
# PERFORMANCE TARGETS
# ========================================
# These are not environment variables, but production SLAs:
#
# Single Prediction:
# - Latency p95: <100ms
# - Latency p99: <200ms
# - Throughput: >10 predictions/second
#
# Batch Prediction (500 batteries):
# - Latency p95: <5 seconds
# - Latency p99: <10 seconds
# - Throughput: >100 batteries/second
#
# Full Fleet Prediction (1,944 batteries):
# - Total time: <20 seconds (4 batches × 5 seconds)
# - Memory usage: <2GB peak
# - CPU usage: 60-80% average during batch
