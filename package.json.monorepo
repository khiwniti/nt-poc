{
  "name": "@nt-poc/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Battery Management System - Monorepo",
  "workspaces": [
    "services/backend",
    "services/frontend",
    "services/line-bot"
  ],
  "scripts": {
    "test:integration:setup": "bash ./tests/scripts/test-env-up.sh",
    "test:integration:teardown": "bash ./tests/scripts/test-env-down.sh",
    "test:integration": "npm run test:integration:setup && npm run test:integration:run && npm run test:integration:teardown",
    "test:integration:run": "vitest run --config tests/integration/vitest.config.ts",
    "install:all": "npm install && npm run install:python",
    "install:python": "echo 'Please install Python dependencies manually with virtual environments. See README.md for instructions.'",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@nt-poc/backend",
    "dev:frontend": "npm run dev --workspace=@nt-poc/frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "quality": "npm run quality --workspaces --if-present",
    "test:pact": "npm run test:pact --workspace=@nt-poc/frontend && npm run test:pact:verify --workspace=@nt-poc/backend",
    "test:pact:consumer": "npm run test:pact --workspace=@nt-poc/frontend",
    "test:pact:provider": "npm run test:pact:verify --workspace=@nt-poc/backend",
    "clean": "rm -rf node_modules services/*/node_modules services/*/dist && find services -type d -name '__pycache__' -exec rm -rf {} +"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=7.0.0"
  }
}
