{
  "name": "chaos-tests",
  "version": "1.0.0",
  "description": "Chaos testing suite for BMS resilience validation",
  "type": "module",
  "scripts": {
    "test:chaos": "node scenarios/runAll.js",
    "test:service-failure": "node scenarios/serviceFailure.js",
    "test:network-latency": "node scenarios/networkLatency.js",
    "test:database-failure": "node scenarios/databaseFailure.js",
    "test:redis-failure": "node scenarios/redisFailure.js",
    "test:recovery": "node scenarios/recoveryValidation.js",
    "test:report": "node utils/generateReport.js",
    "docker:up": "docker-compose -f docker-compose.chaos.yml up -d",
    "docker:down": "docker-compose -f docker-compose.chaos.yml down",
    "docker:logs": "docker-compose -f docker-compose.chaos.yml logs -f"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "dockerode": "^4.0.2",
    "toxiproxy-node-client": "^2.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.6"
  }
}
